<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">StopCast</string>

    <!-- Freshness stamp in the top bar. %1$s is "just now" / "3 min ago". -->
    <string name="updated_stamp">Updated %1$s</string>
    <string name="stale_stamp">Tap to refresh</string>
    <!-- Pending stamp shown before the first snapshot is available (cold start, while the
         persisted snapshot is read off disk), so the placeholder frame carries a stamp
         rather than appearing without one (SPEC snapshot-render). -->
    <string name="loading_stamp">Loading…</string>

    <!-- Departures list -->
    <string name="departures_loading">Loading departures…</string>
    <string name="departures_empty">No upcoming departures</string>
    <!-- Empty list from a stale snapshot: don't assert "none" from data too old to
         trust — say it may be out of date and prompt a refresh (SPEC D4). -->
    <string name="departures_stale_empty">Departures may be out of date</string>
    <string name="refresh">Refresh</string>
    <!-- Star (pin-to-top) on a departure card, toggled by a long-press on the card; a pinned
         card is marked by a gold border, not an in-row element. `star` / `unstar` are the
         long-press action labels, so they flip with the state (a screen reader hears what the
         long-press does). -->
    <string name="star">Pin to top</string>
    <string name="unstar">Unpin from top</string>
    <!-- Transient snackbar when saving a pin/unpin fails (storage full, an IO error), so a
         tap that didn't take isn't silent. -->
    <string name="star_write_failed">Couldn\'t save your pin</string>
    <!-- Route detail dialog, opened by a tap on a departure/route card (a long-press still pins).
         `departure_details` is the card's tap action label a screen reader announces. The dialog
         carries the star (the discoverable, labeled control) and the line's full disruption text. -->
    <string name="departure_details">Show details</string>
    <!-- %1$s is a comma-separated list of the terminus names the service runs to. -->
    <string name="route_detail_towards">Towards %1$s</string>
    <string name="route_detail_no_disruption">No disruptions reported</string>
    <!-- Shown in the route detail when its snapshot is stale: the disruption status is from old
         data, so the detail (which carries no freshness stamp of its own) says so rather than
         present stale status as current (SPEC D4). Not a "no disruptions" claim. -->
    <string name="route_detail_status_stale">Status may be out of date</string>
    <!-- Shown when some watched stops refreshed but at least one failed. -->
    <string name="partial_refresh">Some stops couldn\'t be refreshed</string>
    <!-- Shown when arrivals loaded but the disruption lookup failed, so these times'
         disruption status was never checked (SPEC Disruptions: not verified-clean). -->
    <string name="disruptions_unknown">Couldn\'t check for disruptions</string>
    <!-- Click labels for the stop-closure card, which collapses a long TfL notice to one
         line and expands to the full text on tap. Announced by a screen reader as the action
         ("double tap to Show full alert"); the notice text itself is read from the card. -->
    <string name="alert_expand">Show full alert</string>
    <string name="alert_collapse">Show less</string>
    <!-- On a status row: a disrupted line (e.g. suspended) returning no predictions. Sits
         where a countdown would, as a short dash meaning "none" — distinct from the "?" a
         stale timed row shows for an unknown/withheld countdown. The chip beside it names
         the disruption. A screen reader announces the description below instead of the bare
         dash, which alone could read as missing data rather than zero departures. -->
    <string name="status_no_departures">–</string>
    <string name="status_no_departures_description">No departures</string>
    <!-- A timed row's destination line when TfL gives neither destination nor towards but
         did give a direction; used only when even the direction is missing. -->
    <string name="destination_unknown">Unknown destination</string>
    <!-- Shown over the aged last-good list when a refresh failed outright. -->
    <string name="refresh_failed_offline">Couldn\'t refresh — you\'re offline</string>
    <string name="refresh_failed_rate_limited">Couldn\'t refresh — TfL is rate-limiting</string>
    <string name="refresh_failed_unreachable">Couldn\'t refresh — can\'t reach TfL</string>

    <!-- Honest failure states (SPEC principles 1–2) -->
    <string name="error_offline">You\'re offline</string>
    <string name="error_rate_limited">TfL is rate-limiting requests</string>
    <string name="error_unreachable">Can\'t reach TfL</string>

    <!-- Location gate: the nearby-stops search (SPEC Finding stops). The rationale is
         honest about the location leaving the device, since it does — it's sent to TfL to
         find nearby stops (SPEC Privacy). -->
    <string name="location_title">Departures near you</string>
    <string name="location_rationale">StopCast shows the stops nearest you. Your location is sent to TfL only to find them.</string>
    <string name="location_allow">Allow location</string>
    <string name="location_finding">Finding stops near you…</string>
    <string name="location_no_fix">Couldn\'t get your location</string>
    <string name="location_no_stops">No stops found nearby</string>
    <string name="try_again">Try again</string>
    <!-- Shown after a permanent permission denial, where re-requesting can't prompt again. -->
    <string name="location_denied">Turn on location access in Settings to see nearby stops.</string>
    <string name="open_settings">Open settings</string>

    <!-- Shown in the widget picker. -->
    <string name="widget_description">Live departures from the stops near you</string>

    <!-- Overflow (three-dot) button in the departures top bar. Neutral because the menu now
         opens more than one destination (Settings and About), so a screen reader shouldn't
         announce it as any single one. -->
    <string name="menu_more">More options</string>

    <!-- Marks the overflow menu with a red dot, and appears as a menu item, when a newer
         version is available on Google Play; the item opens the Play listing. Used as the
         dot's accessible description too. -->
    <string name="update_available">Update available</string>
    <!-- Toast when neither the Play app nor a browser can open the Play listing. -->
    <string name="update_open_failed">No app to open Google Play</string>

    <!-- Settings screen. -->
    <string name="menu_settings">Settings</string>
    <string name="settings_title">Settings</string>
    <string name="settings_live_widget_refresh_title">Refresh widget every minute</string>
    <string name="settings_live_widget_refresh_summary">Refreshes the home-screen widget about once a minute in the background. Uses more battery and data.</string>
    <!-- Shown under the toggle when the setting saved but the background refresh couldn't be
         scheduled (a rare storage/WorkManager error); the choice is kept and retried later. -->
    <string name="settings_live_widget_refresh_failed">Couldn\'t update live refresh</string>
    <string name="action_dismiss">Dismiss</string>

    <!-- Text-size (display scaling) settings. The size multiplies the system font size; the pinch
         switch gates the two-finger gesture. -->
    <string name="settings_text_size_title">Text size</string>
    <!-- %1$d is the size as a percentage of the system size (100 = system size). -->
    <string name="settings_text_size_value">%1$d%%</string>
    <string name="settings_text_size_reset">Reset</string>
    <string name="settings_text_size_content_description">Text size, %1$d percent</string>
    <string name="settings_pinch_title">Pinch to resize text</string>
    <string name="settings_pinch_summary">Spread or pinch two fingers anywhere in the app to change the text size.</string>

    <!-- About dialog and open-source licenses screen. -->
    <string name="menu_about">About</string>
    <string name="about_title">About</string>
    <string name="settings_version">Version %1$s</string>
    <string name="settings_licenses_title">Open source licenses</string>
    <string name="settings_licenses_authors">By %1$s</string>
    <string name="action_back">Back</string>
    <string name="action_done">Done</string>
    <string name="action_close">Close</string>
    <!-- Toast when a device has no browser to open a license's full text online. -->
    <string name="licenses_link_failed">No app to open the license page</string>

    <!-- "More" controls at the foot of the near-me list: reveal the farther clusters of a mode
         (SPEC *Finding stops → Near me now*). One per mode still holding an unrevealed cluster.
         PROVISIONAL WORDING — pending the maintainer's sign-off before translation. -->
    <string name="more_stops">More stops</string>
    <string name="more_stops_bus">More bus stops</string>
    <string name="more_stops_tube">More Tube stations</string>
    <string name="more_stops_dlr">More DLR stations</string>
    <string name="more_stops_overground">More Overground stations</string>
    <string name="more_stops_elizabeth">More Elizabeth line stations</string>
    <string name="more_stops_tram">More tram stops</string>
    <string name="more_stops_rail">More rail stations</string>
    <string name="more_stops_coach">More coach stops</string>
    <string name="more_stops_river">More river bus piers</string>

    <!-- Bug report (SPEC Privacy). Overflow item, then the consent screen that spells out what
         leaves the device before anything is shared. The copy is deliberately plain that it
         shares the EXACT location — this report is the honest, consent-gated one, not a
         location-safe export. -->
    <string name="menu_send_bug_report">Send bug report</string>
    <string name="bug_report_consent_title">Send bug report</string>
    <string name="bug_report_consent_body">To help fix a problem, this shares:\n\n• a diagnostic log (stops, lines, and errors the app saw)\n• a screenshot of this screen\n• your exact location\n• how far you are from each nearby stop\n\nOn Continue, the report is copied to your clipboard and offered to an app you pick.</string>
    <string name="bug_report_consent_dont_ask">Don\'t ask again</string>
    <string name="bug_report_consent_continue">Continue</string>
    <string name="action_cancel">Cancel</string>
    <!-- Subject line and share-sheet / clipboard labels for the report. -->
    <string name="bug_report_subject">StopCast bug report</string>
    <string name="bug_report_chooser_title">Send bug report</string>
    <string name="bug_report_clipboard_label">StopCast bug report</string>
    <!-- Toasts when the share sheet didn't open (the report is on the clipboard) or nothing landed. -->
    <string name="bug_report_copied">Bug report copied to clipboard</string>
    <string name="bug_report_failed">Couldn\'t share the bug report</string>
</resources>
