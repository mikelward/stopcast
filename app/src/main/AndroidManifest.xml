<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Precise location for the nearby-stops search: a coarse fix put the nearest stop up to
         ~1 km off (a stop half a mile away read as nearest), so trackmo requests FINE and uses
         it when granted (maintainer, 2026-09-19). COARSE stays declared so the runtime dialog
         offers the precise/approximate choice and an approximate grant still finds stops,
         degraded. Location is used on demand only — sent to TfL to find stops, never on a
         background refresh (SPEC Finding stops / Privacy). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Trackmo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Trackmo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
