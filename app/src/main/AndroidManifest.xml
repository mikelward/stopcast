<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Precise location for the nearby-stops search: a coarse fix put the nearest stop up to
         ~1 km off (a stop half a mile away read as nearest), so stopcast requests FINE and uses
         it when granted (maintainer, 2026-09-19). COARSE stays declared so the runtime dialog
         offers the precise/approximate choice and an approximate grant still finds stops,
         degraded. Location is used on demand only — sent to TfL to find stops, never on a
         background refresh (SPEC Finding stops / Privacy). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".StopcastApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.StopCast">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StopCast">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The home-screen (and, where the OS allows, lock-screen) widget. Glance's receiver
             handles the APPWIDGET_UPDATE plumbing; the provider meta-data points at the sizing
             and category config. exported=true because the launcher/host binds it. -->
        <receiver
            android:name=".widget.StopCastWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stopcast_widget_info" />
        </receiver>

        <!-- Serves the bug-report screenshot to the app the user picks in the share sheet.
             Not exported: only the chooser target we grant a read to (per-Uri, per-share) can
             read it; nothing else, and never the rest of the cache (see @xml/file_paths). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
